{
  "name": "buildsieve",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm content:validate && next dev",
    "build": "pnpm content:validate && next build",
    "build:preview": "tsx scripts/build-content.ts --drafts && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:copy": "tsx scripts/lint-copy.ts",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "content:validate": "tsx scripts/build-content.ts",
    "check:css": "tsx scripts/check-css.ts",
    "placeholders": "tsx scripts/placeholders.ts",
    "check": "pnpm content:validate && pnpm lint && pnpm lint:copy && pnpm typecheck && pnpm test && pnpm build && pnpm check:css"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "fuse.js": "7.5.0",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "nuqs": "2.10.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/google-sans-flex": "5.3.2",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  }
}
